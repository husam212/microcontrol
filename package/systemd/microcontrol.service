[Unit]
Description=MicroControl daemon
PartOf=graphical-session.target
After=graphical-session.target
StartLimitIntervalSec=30
StartLimitBurst=3

[Service]
Type=dbus
BusName=dev.husam.MicroControl.Daemon
ExecStart=/usr/bin/microcontrol --daemon
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
